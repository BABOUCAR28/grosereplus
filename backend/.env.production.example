# ── Environnement ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Base de données MySQL ──────────────────────────────────────
# DB_HOST = "mysql" (nom du service Docker, pas localhost)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gp_suite
DB_USER=gp_user
DB_PASSWORD=TFur*l3QjPwMF%iCAKbLCs70
DB_ROOT_PASSWORD=V2zmM5QMxB6dz6TvFGDAV59p

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=b38b8145dd136a3e93b279ecd94b87626746cf43b34d151e57e3d60bac9722ae
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=d68c9241da1e7dd96ab41a79c852fb5df2467f7b3102e12022dc452a6238c91c
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS et URL publique ───────────────────────────────────────
CORS_ORIGIN=https://grosereplus.com
FRONTEND_URL=https://grosereplus.com

# ── Gmail SMTP ─────────────────────────────────────────────────
# SMTP_PASSWORD = le code de 16 caractères fourni par Google
# (Compte Google → Sécurité → Mots de passe des applications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=grosereplus@gmail.com
SMTP_PASSWORD=COLLER_ICI_LE_CODE_16_CARACTERES_GOOGLE
SMTP_FROM="GROSERE PLUS <grosereplus@gmail.com>"

# Brevo non utilisé
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ── Upload ─────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=20
UPLOAD_DIR=uploads

# ── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Mots de passe des comptes administrateurs ──────────────────
# Ces variables sont lues par le seeder lors du premier déploiement.
# Après le premier "db:seed:all", vous pouvez les changer via
# l'interface de l'application (Paramètres → Profil → Mot de passe).
# Règles : min. 12 caractères, majuscule + minuscule + chiffre + symbole.
ADMIN_PASSWORD_GROSEREPLUS=CHOISIR_UN_MOT_DE_PASSE_FORT_ICI
ADMIN_PASSWORD_CORISENE=CHOISIR_UN_MOT_DE_PASSE_FORT_ICI
ADMIN_PASSWORD_BABOUCAR=CHOISIR_UN_MOT_DE_PASSE_FORT_ICI
