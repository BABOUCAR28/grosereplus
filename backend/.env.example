# Environnement
NODE_ENV=development
PORT=5000

# Base de données MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gp_suite
DB_USER=gp_user
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# JWT
JWT_SECRET=change_this_super_secret_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_other_super_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# URL publique du frontend (utilisée pour construire les liens dans les e-mails,
# ex. lien de réinitialisation de mot de passe)
FRONTEND_URL=http://localhost:5173

# Envoi d'e-mail — si aucune des deux méthodes ci-dessous n'est configurée,
# l'application continue de fonctionner mais aucun e-mail réel n'est envoyé
# (les endpoints le signalent honnêtement, jamais un faux succès).
#
# MÉTHODE RECOMMANDÉE : API Brevo (anciennement Sendinblue), via HTTPS/443 —
# ne peut pas être bloquée par un hébergeur qui filtre les ports SMTP
# sortants (25/465/587), contrairement à la méthode SMTP ci-dessous.
#   1. Créer un compte sur https://www.brevo.com (300 e-mails/jour gratuits)
#   2. Vérifier un expéditeur : Paramètres > Expéditeurs, e-mails et domaines
#   3. Générer une clé API : Paramètres > SMTP & API > API Keys
#   4. Renseigner BREVO_API_KEY et BREVO_SENDER_EMAIL (ou SMTP_FROM) ci-dessous
# Si BREVO_API_KEY est renseignée, elle est utilisée en priorité (les
# variables SMTP_* ci-dessous sont alors ignorées).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# MÉTHODE ALTERNATIVE : SMTP classique (Gmail, ou Brevo en mode "SMTP relay").
# ⚠️ Pour Brevo en SMTP, SMTP_PASSWORD doit être une CLÉ SMTP (Paramètres >
# SMTP & API > onglet SMTP), PAS la clé API ci-dessus — Brevo refuse
# explicitement la clé API comme mot de passe SMTP (erreur 535).
#
# Exemple avec Gmail :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=votre.compte@gmail.com
#   SMTP_PASSWORD=mot-de-passe-application-16-caracteres   (PAS le mot de passe Gmail normal —
#                  à générer sur https://myaccount.google.com/apppasswords,
#                  nécessite la validation en 2 étapes activée sur le compte Google)
#   SMTP_FROM="GP-Suite <votre.compte@gmail.com>"
#
# Exemple avec Brevo (SMTP relay) :
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<login SMTP affiché sur la page Paramètres > SMTP & API — PAS "smtp-relay.brevo.com">
#   SMTP_PASSWORD=<clé SMTP, pas la clé API>
#   SMTP_FROM="GP-Suite <votre-expediteur-verifie@exemple.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Upload
UPLOAD_MAX_SIZE_MB=20
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
