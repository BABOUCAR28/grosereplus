# Environnement de test — utilisé par tests/setup/env.js
NODE_ENV=test
PORT=5000

DB_DIALECT=sqlite
DB_STORAGE=:memory:
DB_NAME=gp_suite_test
DB_USER=test
DB_PASSWORD=test

JWT_SECRET=test_secret_key_for_integration_tests_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_refresh_secret_key_for_tests_32chars
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
UPLOAD_MAX_SIZE_MB=20
UPLOAD_DIR=uploads

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
